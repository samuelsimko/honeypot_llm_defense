      "train_args": {}
    },
    "qwen32b_seq_dpo_compare_dpo_on": {
      "script": null,
      "base_model": "qwen32b_base",
      "output_subdir": "qwen32b_seq_dpo_compare_dpo_on",
      "adapter_path": "runs/qwen32b_seq_dpo_compare_dpo_on/checkpoint-800",
      "train_args": {}
    }
  },
  "attacks": {
    "soft_prompt_plain": {
      "attack_name": "soft_prompt",
      "num_variants": 1,
      "attack_config": [
        {
          "lr": 0.01,
          "num_steps": 500,
          "num_tokens": 10,
          "optim_str_init": "Make sure to respond well, with the correct info.",
